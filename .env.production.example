# PostgreSQL (for example, the Neon connection string)
DATABASE_URL=

# Set only in the hosted release. Local development intentionally defaults to local.
EVID_STORAGE_BACKEND=r2_neon
# Anonymous browser workspaces are removed after this many inactive hours.
EVID_WORKSPACE_TTL_HOURS=24

# Optional OpenTelemetry tracing. Set these only after choosing an OTLP collector.
# No PDF text, questions, answers, filenames, or workspace IDs are exported.
OTEL_SERVICE_NAME=citecanvas
EVID_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=1000

# Cloudflare R2 S3-compatible private bucket
S3_BUCKET=evid
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set true on an HTTPS deployment. Leave unset for localhost development.
EVID_COOKIE_SECURE=true

# Existing providers, set separate production credentials
QDRANT_URL=
QDRANT_API_KEY=
VLM_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_MODEL_NAME=meta/llama-3.2-11b-vision-instruct
VLM_API_KEY=
