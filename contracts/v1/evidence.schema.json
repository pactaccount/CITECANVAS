{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceEvidence",
  "type": "object",
  "required": ["id", "source", "content_type", "content", "citation"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "description": "URI or identifier of source document/procedure." },
    "content_type": { "type": "string", "enum": ["text_passage", "image_region", "batch_field", "procedure_version", "model_prediction"] },
    "content": { "type": "string" },
    "citation": {
      "type": "object",
      "required": ["supported", "label"],
      "properties": {
        "supported": { "type": "boolean", "description": "Whether this evidence actually supports the claim." },
        "label": { "type": "string", "enum": ["direct", "indirect", "abstain", "unsupported", "contradictory"] },
        "reason": { "type": "string" }
      }
    },
    "model_card_ref": { "type": "string", "description": "If source is a model prediction, reference model card with seed/hash." }
  }
}
