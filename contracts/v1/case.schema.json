{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceCase",
  "type": "object",
  "required": ["id", "domain", "submitted_at", "evidence", "metadata"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "domain": { "type": "string", "enum": ["manufacturing", "legal", "technical_support", "customer_service"] },
    "submitted_at": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "object",
      "required": ["images", "batch_record"],
      "properties": {
        "images": { "type": "array", "items": { "type": "object", "required": ["uri", "captured_at"], "properties": { "uri": { "type": "string" }, "captured_at": { "type": "string", "format": "date-time" }, "label": { "type": "string" } } } },
        "batch_record": { "type": "object", "required": ["batch_id", "line", "timestamp"], "properties": { "batch_id": { "type": "string" }, "line": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "fields": { "type": "object" } } }
      }
    },
    "metadata": { "type": "object", "properties": { "author": { "type": "string" }, "status": { "type": "string", "enum": ["submitted", "review_pending", "approved", "rejected", "interrupted"] }, "tags": { "type": "array", "items": { "type": "string" } } }
  }
}
